{
  "name": "game-emulator",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run dev:pwa",
    "dev:pwa": "pnpm --filter @game-emulator/pwa run dev",
    "dev:app": "pnpm --filter @game-emulator/app run dev",
    "build:pwa": "pnpm --filter @game-emulator/pwa run build",
    "build:app": "pnpm --filter @game-emulator/app run build",
    "build:android-tv:frontend": "pnpm --filter @game-emulator/android-tv run build:frontend",
    "build:android-tv": "pnpm --filter @game-emulator/android-tv run build",
    "build:android-tv:release": "pnpm --filter @game-emulator/android-tv run build:release",
    "android-tv:install": "pnpm --filter @game-emulator/android-tv run install:device",
    "test:android-tv": "pnpm --filter @game-emulator/android-tv run test",
    "android:init": "pnpm --filter @game-emulator/app run android:init",
    "android:dev": "pnpm --filter @game-emulator/app run android:dev",
    "android:build": "pnpm --filter @game-emulator/app run android:build",
    "ios:dev": "pnpm --filter @game-emulator/app run ios:dev",
    "ios:build": "pnpm --filter @game-emulator/app run ios:build",
    "release": "node scripts/release.cjs",
    "ios:init": "pnpm --filter @game-emulator/app run ios:init",
    "sync:versions": "node scripts/sync-versions.cjs",
    "sync:icons": "node scripts/sync-icons.cjs",
    "debug:app": "cargo build --manifest-path apps/app/src-tauri/Cargo.toml"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
