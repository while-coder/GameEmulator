{
  "manifest_version": 2,
  "name": "GameEmulator TV host bridge",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "tv-bridge@gameemulator.local" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
