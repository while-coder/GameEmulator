{
  "name": "@game-emulator/android-tv",
  "private": true,
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:frontend": "vue-tsc -b --force && vite build",
    "build": "node scripts/build.cjs assembleDebug",
    "build:release": "node scripts/build.cjs assembleRelease",
    "install:device": "node scripts/build.cjs installDebug",
    "test": "node --test scripts/*.test.cjs && node scripts/build.cjs testDebugUnitTest"
  },
  "dependencies": {
    "@game-emulator/android-native": "workspace:*",
    "vue": "catalog:",
    "@game-emulator/shell": "workspace:*",
    "@game-emulator/nes": "workspace:*",
    "@game-emulator/arcade": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
